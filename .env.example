NODE_ENV=development
PORT=5010

MONGODB_URI=mongodb://mongo:password@host:port/database?authSource=admin
DB_NAME=harx

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=86400000

CORS_ORIGIN=https://v25-platform-training-frontend.vercel.app,https://v25-process-connections.vercel.app

UPLOAD_DIR=uploads
MAX_FILE_SIZE=524288000

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_MAX_TOKENS=4096


ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_monolingual_v1

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_PRESET_TRAINING_IMAGES=bf1katla
CLOUDINARY_PRESET_TRAINING_CONTENT=hio38iac
CLOUDINARY_PRESET_MOCKCALLS=kuecaxbp
CLOUDINARY_IMAGE_LIMIT_SIZE_MB=10
CLOUDINARY_DOCUMENT_LIMIT_SIZE_MB=50
CLOUDINARY_VIDEO_LIMIT_SIZE_MB=100
# Dossier Cloudinary pour les illustrations de slides (après génération IA)
CLOUDINARY_SLIDE_ILLUSTRATIONS_FOLDER=training/slide-illustrations

# Images des slides : auto | openai | claude | none
# auto : DALL·E si OPENAI_API_KEY, sinon illustration SVG générée par Claude (ANTHROPIC_API_KEY), sinon image de secours.
# openai : uniquement DALL·E (prompt d’abord affiné par Claude si ANTHROPIC_API_KEY).
# claude : uniquement SVG par Claude (pas de pixels / pas d’OpenAI).
IMAGE_GENERATION_PROVIDER=
OPENAI_IMAGE_MODEL=dall-e-3

# Désactiver enrichissement illustrationUrl après generate-presentation
SKIP_PRESENTATION_ILLUSTRATION_URLS=
